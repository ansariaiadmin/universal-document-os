# ============================================
# universal-document-os — .env.example — جادوگر v3.0.0 — پشتیبانی صفر — Zero Support
# cp .env.example .env → ./install.sh
# ============================================

PORT=8000
# DATA_DIR=./data

# --- OCR — با راهنما همون‌جا ---
# چیه؟ خوندن متن از PDF/عکس — گزینه: tesseract (لوکال رایگان), paddle, easy, mock
# Tesseract: لوکال رایگان — پیش‌فرض — بدون نیاز به API
OCR_PROVIDER=tesseract
TESSERACT_CMD=/usr/bin/tesseract
PADDLE_OCR_ENABLED=true
EASY_OCR_ENABLED=true

# --- Translation — ترجمه — اختیاری ---
# چیه؟ ترجمه متن سند — گزینه: google (https://cloud.google.com/translate), mock
TRANSLATION_ENABLED=false
TRANSLATION_API_KEY=
LAYOUT_PARSER_ENABLED=true

# --- SMS + Email — برای ناتیف اسناد ---
SMS_PROVIDER=mock
SMS_API_KEY=
EMAIL_PROVIDER=mock
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=pass

# --- Notification System — سقف 10/10 — جدید v3.0.0 ---
# چیه؟ اطلاع‌رسانی آپلود + OCR + ترجمه — کانال‌ها: in_app + email + telegram
NOTIF_IN_APP=true
NOTIF_EMAIL=true
NOTIF_SMS=false
NOTIF_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
