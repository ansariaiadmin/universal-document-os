# universal-document-os — Environment Template (local-first, no secrets)
# Copy to .env: cp .env.example .env

PORT=8000
# Optional: custom data dir
# DATA_DIR=./data

# Optional: OCR engines (v2)
# TESSERACT_CMD=/usr/bin/tesseract
# PADDLE_OCR_ENABLED=false

# Optional: translation (v2)
# TRANSLATION_ENABLED=false
# TRANSLATION_API_KEY=

# Optional: layout rebuild (v2)
# LAYOUT_PARSER_ENABLED=false
